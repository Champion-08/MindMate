# ==============================================================================
# MindMate — Environment Variables Configuration
# ==============================================================================

# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI (Server-side for Vercel functions, optional client fallback)
# Set GEMINI_API_KEY in your Vercel project settings or production environment:
GEMINI_API_KEY=your-gemini-api-key-here
# Optional for local development with Vite dev server:
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# AI Mode Defaults: 'auto' | 'online' | 'offline'
VITE_DEFAULT_AI_MODE=auto

# Local WebLLM WebGPU Default Model
# Options:
# - 'SmolLM2-360M-Instruct-q4f16_1-MLC' (~230MB - default lightweight)
# - 'Qwen2.5-0.5B-Instruct-q4f16_1-MLC' (~390MB)
# - 'Qwen2.5-1.5B-Instruct-q4f16_1-MLC' (~950MB)
VITE_LOCAL_MODEL=SmolLM2-360M-Instruct-q4f16_1-MLC
